{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode-security-guidance.local/schema/findings-v1.json",
  "title": "Security Guidance Findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filePath", "category", "vulnerableCode", "explanation", "fix", "severity"],
        "properties": {
          "filePath": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "vulnerableCode": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1 },
          "fix": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
