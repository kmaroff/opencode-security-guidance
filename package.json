{
  "name": "opencode-security-guidance",
  "version": "0.1.0-alpha.1",
  "description": "Independent OpenCode port of Anthropic security-guidance",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && npm run test:ts && ./scripts/run-pytest.sh",
    "test:ts": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/test-ts/*.test.js",
    "test:python": "./scripts/run-pytest.sh",
    "test:bridge": "./scripts/run-pytest.sh test/test_bridge.py",
    "smoke:opencode": "npm run build && ./scripts/opencode-smoke.sh"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.29",
    "@opencode-ai/sdk": "1.18.29",
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "typescript": "5.8.3"
  }
}
